;; @version 0.1.0-alpha

[#] title="ANDRIANANAHARY, MASINA INDRINDR "
[#] author="Nad. J. A. Houlder, 1844-1932"
[#] composer="A. Stone"
[#] description="FFPM 1"
[#] meter={12,13,11}
[#] tags={"evangelic","ffpm"}
[#] language="mg"

[$] key={E} | time={4,4} | tempo={100} | voices={S,A,T,B}

---

[S] |d        :d        !m        :m        ||
[A] |s-1      :s-1      !d        :d        ||
[T] |m        :m        !d        :d        ||
[B] |d        :d        !l-1      :l-1      ||

--

[S] |s        :-        !s        :-        ||
[A] |t-1      :r        !d        :t-1      ||
[T] |r        :f        !m        :s        ||
[B] |s-1      :-        !d        :-        ||

--

[S] |l        :-   .l   !l        :l        ||
[A] |l-1      :t-1      !d        :r        ||
[T] |f        :s        !l        :t        ||
[B] |f-1      :-   .f-1 !f-1      :f-1      ||

--

[S] |s        :-        !m        :-        ||
[A] |m        :-        !d        :-        ||
[T] |d+1      :s        !s        :-        ||
[B] |d        :-        !d        :-        ||

--

[S] |s        :-   .s   !s        :s        ||
[A] |r        :r        !m        :r        ||
[T] |s        :s        !s        :s        ||
[B] |t-1      :-   .t-1 !d        :t-1      ||

--

[S] |d+1      :d+1      !t        :s        ||
[A] |d        :r        !r        :m        ||
[T] |m        :fi       !s        :s        ||
[B] |l-1      :l-1      !t-1      :d        ||

--

[S] |r        :s        !l        :-   .s   ||
[A] |r        :t-1      !d        :-   .t-1 ||
[T] |t        :s        !fi       :-   .s   ||
[B] |r        :r        !r        :-   .s-1 ||

--

[S] |s        :-        !-        :-        ||
[A] |t-1      :-        !-        :-        ||
[T] |s        :-        !f        :-        ||
[B] |s-1      :-        !-        :-        ||

--

[S] |d        :d        !m        :m        ||
[A] |s-1      :s-1      !d        :d        ||
[T] |m        :m        !d        :d        ||
[B] |d        :d        !l-1      :l-1      ||

--

[S] |s        :-        !s        :-        ||
[A] |t-1      :r        !d        :t-1      ||
[T] |r        :f        !m        :s        ||
[B] |s-1      :-        !d        :-        ||

--

[S] |l        :-   .l   !l        :l        ||
[A] |l-1      :t-1      !d        :r        ||
[T] |f        :s        !l        :t        ||
[B] |f-1      :-   .f-1 !f-1      :f-1      ||

--

[S] |s        :-        !s        :-        ||
[A] |m        :-        !d        :-        ||
[T] |d+1      :s        !m        :-        ||
[B] |d        :-        !d        :-        ||

--

[S] |d+1      :d+1      !s        :s        ||
[A] |d        :d        !d        :d        ||
[T] |m        :f        !s        :ta       ||
[B] |l-1      :l-1      !m-1      :m-1      ||

--

[S] |l        :-        !m        :-        ||
[A] |d        :-        !d        :ta-1     ||
[T] |l        :-        !s        :-        ||
[B] |f-1      :-        !d        :-        ||

--

[S] |f        :r        !r        :-   .d   ||
[A] |l-1      :l-1      !t-1      :-   .d   ||
[T] |f        :f        !f        :-   .m   ||
[B] |f-1      :f-1      !s-1      :-   .d   ||

--

[S] |d        :-        !-        :-        ||
[A] |d        :-        !-        :-        ||
[T] |m        :-        !-        :-        ||
[B] |d        :-        !-        :-        ||
