;; @version 0.1.0-alpha

[#] title="ANDRIANANAHARY, MASINA INDRINDRA"
[#] author="R. Heber (1783-1826)"
[#] description="FFPM 1"
[#] tags={"evangelic","ffpm"}
[#] language="mg"

[$] key={F} | time={2,4} | tempo={60} | voices={S,T,A,B}

---

[S] |d      .d      :m      .m      |r              :d              ||
[T] |s-1    .s-1    :d      .d      |t-1            :s-1            ||
[A] |m      .m      :s      .s      |f              :m              ||
[B] |d      .d      :d      .d      |s-1            :d              ||

--

[S] |d+1    .d      :s      .m      |l              :s              ||
[T] |m      .m      :d      .d      |`d     .r`     :m              ||
[A] |s      .s      :m      .s      |`l     .t`     :d+1            ||
[B] |d      .d      :m      .d      |f              :d              ||

--

[S] |s      .s      :f      .m      |l      .l      :s      .s      ||
[T] |m      .m      :r      .d      |d      .r      :m      .m      ||
[A] |m      .m      :f      .s      |l      .t      :d+1    .m      ||
[B] |d      .d      :r      .m      |f      .f      :d      .d      ||

--

[S] |f      .m      :r      .d      |t-1            :-              ||
[T] |r      .d      :l-1    .l-1    |s-1            :-              ||
[A] |f      .s      :l      .l      |t              :-              ||
[B] |r      .m      :f      .fi     |s              :-              ||

--

[S] |m      .m      :r      .r      |`d             :d`             ||
[T] |d      .d      :t-1    .t-1    |`l-1           :l-1`           ||
[A] |s      .s      :f      .f      |`m             :m`             ||
[B] |d      .d      :s-1    .s-1    |`l-1           :l-1`           ||

--

[S] |d+1    .d+1    :s      .m      |l              :s              ||
[T] |m      .m      :d      .d      |`d     .r`     :m              ||
[A] |m      .m      :s      .s      |`l     .t`     :d+1            ||
[B] |d      .d      :m      .d      |f              :d              ||

--

[S] |d      .d      :r      .m      |f              :m              ||
[T] |s-1    .s-1    :t-1    .d      |r              :d              ||
[A] |s      .s      :f      .m      |r              :m              ||
[B] |m      .m      :r      .d      |t-1            :d              ||

--

[S] |m      .r      :d      .t-1    |d              :-              ||
[T] |d      .l-1    :s-1    .f  ,-  |m-1            :-              ||
[A] |s      .f      :m      .f      |d              :-              ||
[B] |m-1    .f-1    :s-1    .s-1    |d-1            :-              ||
