[#] title="ISAORANA ANIE ANDRIAMANINTSIKA"
[#] description="FFPM 2"
[#] meter={6,7,6,7,6,6,6,6}
[#] tags={"evangelic","ffpm"}
[#] language="mg"

[$] key={F} | time={4,4} | tempo={100} | voices={S,A,T,B}

---

[S] :s        ||
[A] :d        ||
[T] :m        ||
[B] :d        ||

--

[S] |s        :s        !l        :l        ||
[A] |t-1      :d        !d        :d        ||
[T] |r        :m        !f        :f        ||
[B] |s-1      :d        !f-1      :l-1      ||

--

[S] |s        :-        !         :m        ||
[A] |d        :-        !         :d        ||
[T] |m        :-        !         :s        ||
[B] |d        :-        !         :d        ||

--

[S] |f        :m        !r        :m        ||
[A] |d        :d        !d        :d        ||
[T] |f        :s        !l        :s        ||
[B] |l-1      :s-1      !f-1      :`m-1.f-1`||

--

[$] touches={frm:2}

[S] |r        :-        !d   .    :s        ||
[A] |`d       :t-1`     !s-1 .    :r        ||
[T] |f        :-        !m   .    :r        ||
[B] |s-1      :-        !d-1 .    :t-1      ||

--

[S] |s        :s        !l        :l        ||
[A] |r        :d        !d        :t-1      ||
[T] |m        :s        !f        :f        ||
[B] |d        :m        !f        :r        ||

--

[S] |s        :-        !         :m        ||
[A] |d        :-        !         :ta-1     ||
[T] |s        :-        !         :s        ||
[B] |m        :-        !         :d        ||

--

[S] |f        :m        !r        :m        ||
[A] |`l-1.t-1`:d        !d        :d        ||
[T] |f        :s        !f        :`s  .l`  ||
[B] |r        :d        !l-1      :`s-1.f-1`||

--

[$] touches={frm:2}

[S] |r        :-        !d   .    :r        ||
[A] |`d       :t-1`     !s-1 .    :t-1      ||
[T] |f        :-        !m   .    :s        ||
[B] |s-1      :-        !d   .    :s-1      ||

--

[S] |r        :r        !m        :m        ||
[A] |l-1      :r        !r        :d        ||
[T] |fi       :s        !s        :s        ||
[B] |`r  .d`  :t-1      !d        :d        ||

--

[S] |r        :-        !         :r        ||
[A] |t-1      :-        !         :r        ||
[T] |s        :-        !         :s        ||
[B] |s-1      :-        !         :t-1      ||

--

[S] |m        :s        !s        :fi       ||
[A] |r        :d        !r        :d        ||
[T] |s        :s        !t        :l        ||
[B] |d        :m        !r        :r        ||

--

[S] |s        :-        !         :s        ||
[A] |t-1      :-        !         :d        ||
[T] |s        :-        !         :s        ||
[B] |s-1      :-        !         :m-1      ||

--

[S] |l        :s        !f        :m        ||
[A] |d        :d        !l-1      :di       ||
[T] |f        :m        !f        :l        ||
[B] |f-1      :d        !r        :l-1      ||

--

[S] |f        :-        !         :m        ||
[A] |r        :-        !         :d        ||
[T] |l        :-        !         :l        ||
[B] |r        :-        !         :l-1      ||

--

[S] |r        :m        !r        :r        ||
[A] |`l-1.r`  :d        !d        :t-1      ||
[T] |l        :s        !s        :f        ||
[B] |f-1      :`m-1.f-1`!s-1      :s-1      ||

--

[S] |d        :-        !         :         ||
[A] |s-1      :-        !         :         ||
[T] |m        :-        !         :         ||
[B] |d-1      :-        !         :         ||
